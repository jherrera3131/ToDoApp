<% if user.errors.any? %>
  <div class="alert alert-danger mb-3" role="alert">
    <strong><%= bootstrap_icon "exclamation-triangle", class: "me-1" %>Please fix these errors:</strong>
    <ul class="mb-0 mt-1">
      <% user.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with(model: user) do |f| %>
  <div class="row g-3 mb-2">
    <div class="col-md-6">
      <label class="form-label">First Name</label>
      <%= f.text_field :first_name, class: "form-control", placeholder: "Jane" %>
    </div>
    <div class="col-md-6">
      <label class="form-label">Last Name</label>
      <%= f.text_field :last_name, class: "form-control", placeholder: "Doe" %>
    </div>
  </div>
  <div class="mb-3">
    <label class="form-label">Username</label>
    <%= f.text_field :username, class: "form-control", placeholder: "choose a username" %>
  </div>
  <div class="mb-3">
    <label class="form-label">Email</label>
    <%= f.email_field :email, class: "form-control", placeholder: "your@email.com" %>
  </div>
  <div class="mb-3">
    <label class="form-label">Password</label>
    <%= f.password_field :password, class: "form-control", placeholder: "at least 6 characters" %>
  </div>
  <div class="mb-4">
    <label class="form-label">Confirm Password</label>
    <%= f.password_field :password_confirmation, class: "form-control", placeholder: "repeat password" %>
  </div>
  <div class="d-grid">
    <%= f.submit class: "btn btn-primary btn-lg fw-bold" %>
  </div>
<% end %>
