<% content_for(:title) { @todo.title } %>

<div class="mt-3">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to "ToDos", todos_path %></li>
      <li class="breadcrumb-item active"><%= truncate(@todo.title, length: 40) %></li>
    </ol>
  </nav>

  <div class="nb-detail-card <%= @todo.completed? ? "completed-card" : @todo.priority? ? "priority-card" : "" %>">

    <%# Status banner %>
    <div class="d-flex align-items-center gap-2 mb-3">
      <% if @todo.completed? %>
        <span class="done-badge"><%= bootstrap_icon "check-circle-fill", class: "me-1" %>Completed</span>
      <% elsif @todo.priority? %>
        <span class="priority-badge"><%= bootstrap_icon "exclamation-circle-fill", class: "me-1" %>Priority</span>
      <% else %>
        <span class="badge bg-light">
          <%= bootstrap_icon "clock", class: "me-1" %>Pending
        </span>
      <% end %>
      <span class="todo-cat-tag">
        <%= bootstrap_icon "folder", class: "me-1" %>
        <%= link_to @todo.category.name, category_path(@todo.category), style: "color:inherit; text-decoration:none;" %>
      </span>
    </div>

    <%# Title %>
    <h2 class="nb-detail-title <%= @todo.completed? ? "is-crossed" : "" %>">
      <%= @todo.title %>
    </h2>

    <%# Meta info %>
    <div class="nb-meta-row">
      <span class="me-3">
        <%= bootstrap_icon "calendar3", class: "me-1" %>
        Created <%= @todo.created_at.strftime("%B %d, %Y") %>
      </span>
      <span>
        <%= bootstrap_icon "clock-history", class: "me-1" %>
        Updated <%= @todo.updated_at.strftime("%B %d, %Y") %>
      </span>
    </div>

    <%# Action buttons %>
    <div class="d-flex gap-2 mt-3 flex-wrap">
      <%= link_to edit_todo_path(@todo), class: "btn btn-warning" do %>
        <%= bootstrap_icon "pencil-square", class: "me-1" %> Edit
      <% end %>
      <%= button_to todo_path(@todo), method: :delete, class: "btn btn-danger",
            data: { turbo_confirm: "Delete \"#{@todo.title}\"?" } do %>
        <%= bootstrap_icon "trash", class: "me-1" %> Delete
      <% end %>
      <%= link_to todos_path, class: "btn btn-secondary" do %>
        <%= bootstrap_icon "arrow-left", class: "me-1" %> Back
      <% end %>
    </div>
  </div>
</div>
