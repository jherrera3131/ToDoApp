<%= form_with(model: todo) do |form| %>
  <% if todo.errors.any? %>
    <div class="alert alert-danger mb-3">
      <strong><%= bootstrap_icon "exclamation-triangle", class: "me-1" %>Please fix these errors:</strong>
      <ul class="mb-0 mt-1">
        <% todo.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= form.label :title, "What needs to be done?", class: "form-label" %>
    <%= form.text_field :title, class: "form-control", placeholder: "write it down..." %>
  </div>

  <div class="mb-4">
    <%= form.label :category_id, "Category", class: "form-label" %>
    <%= form.select :category_id,
          options_from_collection_for_select(@categories, :id, :name, todo.category_id),
          { prompt: "— pick a category —" },
          { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <div class="form-check form-switch">
      <%= form.check_box :priority, class: "form-check-input", role: "switch", id: "priority_toggle" %>
      <%= form.label :priority, class: "form-check-label" do %>
        <%= bootstrap_icon "exclamation-circle-fill", class: "me-1", style: "color:var(--nb-rust)" %>
        Mark as <strong>Priority</strong>
      <% end %>
    </div>
  </div>

  <div class="mb-4">
    <div class="form-check form-switch">
      <%= form.check_box :completed, class: "form-check-input", role: "switch", id: "completed_toggle" %>
      <%= form.label :completed, class: "form-check-label" do %>
        <%= bootstrap_icon "check-circle-fill", class: "me-1", style: "color:var(--nb-olive)" %>
        Mark as <strong>Completed</strong>
      <% end %>
    </div>
  </div>

  <div class="d-flex gap-2 pt-2">
    <%= form.submit class: "btn btn-primary px-4" %>
    <%= link_to "Cancel", todos_path, class: "btn btn-secondary" %>
  </div>
<% end %>
