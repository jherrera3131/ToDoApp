</div>

<br>

<div>
  <a class="btn btn-primary" href="<%= micropost_url(@micropost) %>" role="button">Show Post</a>
  <a class="btn btn-primary" href="<%= microposts_url %>" role="button">Back to MicroPosts</a>
</div>
