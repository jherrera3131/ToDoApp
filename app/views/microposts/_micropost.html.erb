<div class="card col-sm-5 mb-3 mb-sm-0">
  <div class="card-body">
    <h5 class="card-title"><%= micropost.by %></h5>
    <h6 class="card-subtitle mb-2 text-body-secondary"><%= micropost.when %></h6>
    <p class="card-text"><%= micropost.context %></p>
    <a href="<%= micropost_url(micropost) %>" class="card-link">Show Post</a>
    <% if owner?(micropost)%>
      <a href="<%= edit_micropost_url(micropost) %>" class="card-link">Edit Post</a>
      <%= button_to "#{bootstrap_icon 'trash'} Delete Post".html_safe, micropost, method: :delete, class: "btn btn-danger btn-sm" %>
    <% end %>

  </div>
</div>
