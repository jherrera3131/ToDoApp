<% content_for(:title) { "Log In" } %>

<div class="row justify-content-center mt-4">
  <div class="col-md-5 col-lg-4">
    <div class="text-center mb-3">
      <div style="font-family:'Lobster Two',cursive; font-size:2.8rem; color:var(--nb-orange); text-shadow:2px 2px 0 rgba(196,99,42,0.2);">
        To Do App
      </div>
      <p style="font-family:'Kalam',cursive; color:var(--nb-ring); font-size:0.95rem;">
        open your notebook
      </p>
    </div>

    <div class="nb-form-page">
      <div class="nb-section-label mb-1">
        <%= bootstrap_icon "box-arrow-in-right", class: "me-1" %>welcome back
      </div>
      <h2 style="font-family:'Playfair Display',serif; color:var(--nb-brown); margin-bottom:1.5rem;">
        Log In
      </h2>
      <%= render "form", session: @session %>
      <hr style="border-color:var(--nb-line); margin: 1.5rem 0;">
      <p class="text-center mb-0" style="font-family:'Kalam',cursive; color:var(--nb-brown-mid);">
        New here? <%= link_to "Sign up for free", signup_path, style: "color:var(--nb-orange);" %>
      </p>
    </div>
  </div>
</div>
