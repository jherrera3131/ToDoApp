<%= form_with(url: login_path, scope: :session) do |f| %>
  <div class="mb-4">
    <label class="form-label">Email</label>
    <%= f.email_field :email, class: "form-control", placeholder: "your@email.com" %>
  </div>
  <div class="mb-4">
    <label class="form-label">Password</label>
    <%= f.password_field :password, class: "form-control", placeholder: "••••••••" %>
  </div>
  <div class="d-grid mt-3">
    <%= f.submit "Open Notebook", class: "btn btn-primary btn-lg fw-bold" %>
  </div>
<% end %>
