<%= form_with(model: category) do |form| %>
  <% if category.errors.any? %>
    <div class="alert alert-danger mb-3">
      <strong><%= bootstrap_icon "exclamation-triangle", class: "me-1" %>Please fix these errors:</strong>
      <ul class="mb-0 mt-1">
        <% category.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= form.label :name, "Category Name", class: "form-label" %>
    <%= form.text_field :name, class: "form-control", placeholder: "name your folder..." %>
  </div>

  <div class="mb-4">
    <%= form.label :description, "Description", class: "form-label" %>
    <%= form.text_area :description, class: "form-control", rows: 3, placeholder: "what goes in here? (optional)" %>
  </div>

  <div class="d-flex gap-2 pt-2">
    <%= form.submit class: "btn btn-primary px-4" %>
    <%= link_to "Cancel", categories_path, class: "btn btn-secondary" %>
  </div>
<% end %>
