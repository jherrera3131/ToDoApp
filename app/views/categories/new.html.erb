<% content_for(:title) { "New Category" } %>

<div class="mt-3">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to "Categories", categories_path %></li>
      <li class="breadcrumb-item active">New Category</li>
    </ol>
  </nav>

  <div class="row justify-content-center">
    <div class="col-lg-7">
      <div class="nb-form-page">
        <div class="nb-section-label mb-1">
          <%= bootstrap_icon "folder-plus", class: "me-1" %>new folder
        </div>
        <h2 style="font-family:'Playfair Display',serif; color:var(--nb-brown); margin-bottom:1.5rem;">
          Create a Category
        </h2>
        <%= render "form", category: @category %>
      </div>
    </div>
  </div>
</div>
