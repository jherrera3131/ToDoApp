<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "To Do App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- Google Fonts: Lobster Two (brand) + Playfair Display (headings) + Kalam (body) + Lato (UI) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lobster+Two:ital,wght@0,400;0,700;1,400&family=Playfair+Display:ital,wght@0,600;0,700;1,500&family=Kalam:wght@300;400;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :main %>
    <%= javascript_include_tag "application", "data-turbolinks-track" => true %>
    <%= javascript_include_tag "main", "data-turbolinks-track" => true %>
  </head>

  <body>
    <!-- ── Navbar ─────────────────────────────────────────────── -->
    <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
      <div class="container">
        <a class="navbar-brand" href="<%= root_path %>">
          <%= bootstrap_icon "pencil-square", class: "me-2", style: "color: var(--nb-orange-lt)" %>To Do App
        </a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
          aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto">
            <% if logged_in? %>
              <li class="nav-item">
                <a class="nav-link" href="<%= todos_path %>">
                  <%= bootstrap_icon "list-check", class: "me-1" %>ToDos
                </a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="<%= categories_path %>">
                  <%= bootstrap_icon "folder2-open", class: "me-1" %>Categories
                </a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="<%= completed_todos_path %>">
                  <%= bootstrap_icon "check2-all", class: "me-1" %>Completed
                </a>
              </li>
            <% end %>
          </ul>

          <div class="d-flex align-items-center gap-2">
            <% if logged_in? %>
              <span class="text-light small">
                <%= bootstrap_icon "pencil", class: "me-1" %>Hello, <strong><%= current_user.first_name %></strong>
              </span>
              <%= link_to user_path(current_user), class: "btn btn-outline-light btn-sm" do %>
                <%= bootstrap_icon "person-circle" %> Profile
              <% end %>
              <%= button_to "Log Out", logout_path, method: :delete, class: "btn btn-outline-danger btn-sm" %>
            <% else %>
              <%= link_to "Log In", login_path, class: "btn btn-outline-light btn-sm" %>
              <%= link_to "Sign Up", signup_path, class: "btn btn-warning btn-sm fw-bold" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <!-- ── Flash Messages ─────────────────────────────────────── -->
    <% if flash[:notice].present? %>
      <div class="alert alert-success alert-dismissible fade show mb-0" role="alert">
        <%= bootstrap_icon "check-circle-fill", class: "me-2" %><%= flash[:notice] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>
    <% if flash[:danger].present? %>
      <div class="alert alert-danger alert-dismissible fade show mb-0" role="alert">
        <%= bootstrap_icon "exclamation-triangle-fill", class: "me-2" %><%= flash[:danger] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>

    <!-- ── Main Content ───────────────────────────────────────── -->
    <div class="container py-3">
      <%= yield %>
    </div>
  </body>
</html>
