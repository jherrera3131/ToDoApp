/* custom color variables */
:root {
  --nb-cream:       #F4EDD8;
  --nb-page:        #FEFCF5;
  --nb-line:        #B8CDE0;
  --nb-margin:      #D45B4A;
  --nb-brown:       #2C1A0E;
  --nb-brown-mid:   #5C3A22;
  --nb-orange:      #C4632A;
  --nb-orange-lt:   #E8854A;
  --nb-olive:       #5A7A38;
  --nb-rust:        #B84040;
  --nb-yellow:      #E4BE44;
  --nb-blue:        #4A6FA5;
  --nb-ring:        #8B7355;
  --nb-shadow:      rgba(44, 26, 14, 0.14);
}

/* base */
html { scroll-behavior: smooth; }

body {
  background-color: var(--nb-cream);
  font-family: 'Kalam', 'Comic Sans MS', cursive;
  color: var(--nb-brown);
  min-height: 100vh;
}

h1, h2, h3, h4, h5, h6 {
  font-family: 'Playfair Display', Georgia, serif;
  color: var(--nb-brown);
}

a { color: var(--nb-blue); }
a:hover { color: var(--nb-orange); text-decoration: none; }

/* navbar */
.navbar {
  background: var(--nb-brown) !important;
  border-bottom: 4px solid var(--nb-orange) !important;
  padding: 0.45rem 1.25rem;
  font-family: 'Lato', sans-serif;
}

.navbar-brand {
  font-family: 'Lobster Two', cursive !important;
  font-size: 1.75rem !important;
  color: var(--nb-yellow) !important;
  letter-spacing: 1px;
  text-shadow: 1px 2px 4px rgba(0,0,0,0.35);
  transition: color 0.2s;
}
.navbar-brand:hover { color: var(--nb-orange-lt) !important; }
.navbar-brand svg { color: var(--nb-orange-lt); }

.navbar .nav-link {
  color: rgba(255, 255, 255, 0.82) !important;
  font-size: 0.88rem;
  font-weight: 400;
  transition: color 0.2s;
  padding: 0.5rem 0.85rem;
  font-family: 'Lato', sans-serif;
}
.navbar .nav-link:hover { color: var(--nb-yellow) !important; }
.navbar .nav-link.active { color: var(--nb-yellow) !important; }

.navbar .text-light { font-family: 'Lato', sans-serif; font-size: 0.85rem; }
.navbar .text-light strong { color: var(--nb-yellow); }

.navbar .btn-outline-light {
  border-color: rgba(255,255,255,0.35);
  color: rgba(255,255,255,0.82);
  font-size: 0.8rem;
  font-family: 'Lato', sans-serif;
}
.navbar .btn-outline-light:hover {
  background: rgba(255,255,255,0.12);
  color: white;
  border-color: rgba(255,255,255,0.6);
}
.navbar .btn-warning {
  background: var(--nb-yellow) !important;
  border-color: var(--nb-yellow) !important;
  color: var(--nb-brown) !important;
  font-weight: 700;
  font-size: 0.8rem;
  font-family: 'Lato', sans-serif;
}
.navbar .btn-outline-danger {
  border-color: rgba(184,64,64,0.6) !important;
  color: #f28b8b !important;
  font-size: 0.8rem;
  font-family: 'Lato', sans-serif;
}
.navbar .btn-outline-danger:hover {
  background: var(--nb-rust) !important;
  color: white !important;
}

/* notebook page - cream paper with red margin and stacked shadow */
.notebook-page {
  background: var(--nb-page);
  border-radius: 2px;
  box-shadow:
    2px 2px 0 #e0d4b0,
    4px 4px 0 #d5c9a5,
    6px 6px 14px var(--nb-shadow);
  position: relative;
  border-left: 5px solid var(--nb-margin);
  padding: 2rem 2rem 2rem 2.25rem;
  margin-top: 28px;
  margin-bottom: 2rem;
  animation: fadeSlideIn 0.35s ease both;
}

/* spiral binding dots across the top */
.notebook-page::before {
  content: '';
  position: absolute;
  top: -22px;
  left: 20px;
  right: 20px;
  height: 22px;
  background-image: radial-gradient(circle at 50% 11px, var(--nb-ring) 7px, transparent 8px);
  background-size: 36px 22px;
  background-repeat: repeat-x;
  background-position: 18px 0;
  pointer-events: none;
}

/* utility class for ruled lines background */
.notebook-ruled {
  background-image: repeating-linear-gradient(
    transparent 0px,
    transparent 39px,
    var(--nb-line) 39px,
    var(--nb-line) 40px
  );
  background-size: 100% 40px;
}

/* page title with orange underline accent */
.page-title {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 1.85rem;
  color: var(--nb-brown);
  font-weight: 700;
  position: relative;
  display: inline-block;
}
.page-title::after {
  content: '';
  display: block;
  width: 50px;
  height: 3px;
  background: var(--nb-orange);
  margin-top: 5px;
  border-radius: 2px;
}

/* small uppercase label above headings */
.nb-section-label {
  font-family: 'Playfair Display', serif;
  font-size: 0.8rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--nb-ring);
  margin-bottom: 0.75rem;
}

/* hero/landing section */
.hero-section {
  background: var(--nb-page);
  border-left: 5px solid var(--nb-margin);
  border-radius: 2px;
  box-shadow:
    2px 2px 0 #e0d4b0,
    5px 5px 0 #d5c9a5,
    8px 8px 18px var(--nb-shadow);
  padding: 3.5rem 3rem 3rem;
  position: relative;
  margin-top: 28px;
  overflow: hidden;
  animation: fadeSlideIn 0.4s ease both;
}
/* binding dots on hero too */
.hero-section::before {
  content: '';
  position: absolute;
  top: -22px;
  left: 20px;
  right: 20px;
  height: 22px;
  background-image: radial-gradient(circle at 50% 11px, var(--nb-ring) 7px, transparent 8px);
  background-size: 36px 22px;
  background-repeat: repeat-x;
  background-position: 18px 0;
}
/* faint ruled lines layered behind hero content */
.hero-section::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image: repeating-linear-gradient(
    transparent 0px,
    transparent 39px,
    var(--nb-line) 39px,
    var(--nb-line) 40px
  );
  background-size: 100% 40px;
  opacity: 0.4;
  pointer-events: none;
  z-index: 0;
}
.hero-section > * { position: relative; z-index: 1; }

.hero-brand {
  font-family: 'Lobster Two', cursive;
  font-size: 4.5rem;
  color: var(--nb-orange);
  text-shadow: 3px 3px 0 rgba(196, 99, 42, 0.18), 5px 5px 12px rgba(44,26,14,0.15);
  line-height: 1;
  margin-bottom: 0.5rem;
}
.hero-tagline {
  font-family: 'Kalam', cursive;
  font-size: 1.2rem;
  color: var(--nb-brown-mid);
  line-height: 1.5;
}
.hero-since {
  font-family: 'Lato', sans-serif;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--nb-ring);
}

/* feature cards on the landing page */
.feature-card {
  background: var(--nb-page);
  border: 2px solid rgba(184, 205, 224, 0.6);
  border-radius: 2px;
  box-shadow: 3px 3px 0 #e0d4b0, 5px 5px 10px var(--nb-shadow);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  margin-top: 0;
}
.feature-card:hover {
  transform: translateY(-5px) rotate(-0.4deg);
  box-shadow: 5px 8px 0 #d5c9a5, 8px 10px 20px var(--nb-shadow);
}
.feature-card .display-5 { color: var(--nb-orange); }

/* dashboard stat cards */
.stat-card {
  background: var(--nb-page);
  border: 2px solid rgba(184, 205, 224, 0.5);
  border-radius: 2px;
  box-shadow: 3px 3px 0 #e0d4b0, 5px 5px 10px var(--nb-shadow);
  transition: transform 0.2s ease;
  position: relative;
  overflow: hidden;
}
.stat-card:hover {
  transform: translateY(-4px) rotate(0.3deg);
  box-shadow: 5px 7px 0 #d5c9a5, 8px 10px 18px var(--nb-shadow);
}
/* colored top bar per stat type */
.stat-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 5px;
}
.stat-card.stat-total::before { background: var(--nb-orange); }
.stat-card.stat-done::before  { background: var(--nb-olive); }
.stat-card.stat-cats::before  { background: var(--nb-blue); }

.stat-number {
  font-family: 'Playfair Display', serif;
  font-size: 3.2rem;
  font-weight: 700;
  line-height: 1;
}
.stat-number.stat-total { color: var(--nb-orange); }
.stat-number.stat-done  { color: var(--nb-olive); }
.stat-number.stat-cats  { color: var(--nb-blue); }

.stat-label {
  font-family: 'Lato', sans-serif;
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--nb-ring);
  margin-top: 0.25rem;
}

/* todo list items - each one sits on a ruled line */
.todo-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.55rem 0.5rem;
  border-bottom: 1px solid var(--nb-line);
  transition: background 0.18s ease;
  position: relative;
  min-height: 44px;
  font-family: 'Kalam', cursive;
  font-size: 1.05rem;
}
.todo-item:first-of-type { border-top: 1px solid var(--nb-line); }
.todo-item:hover { background: rgba(196, 99, 42, 0.05); }

.todo-item.todo-priority {
  background: rgba(184, 64, 64, 0.055) !important;
}
/* red left accent bar for priority items */
.todo-item.todo-priority::after {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3px;
  background: var(--nb-rust);
  margin-left: -5px;
}

.todo-item.todo-completed { opacity: 0.72; }
.todo-item.todo-completed:hover { background: rgba(90,122,56,0.06) !important; }

/* strikethrough line draws across completed todo title */
.todo-title {
  position: relative;
  flex: 1;
}
.todo-title::after {
  content: '';
  position: absolute;
  top: 53%;
  left: -2px;
  height: 2px;
  background: var(--nb-brown-mid);
  width: 0;
  transform-origin: left center;
  pointer-events: none;
}
.todo-completed .todo-title::after {
  animation: strikeThrough 0.55s ease 0.1s forwards;
}

@keyframes strikeThrough {
  from { width: 0; }
  to   { width: calc(100% + 4px); }
}

/* custom checkbox */
.nb-check {
  width: 22px;
  height: 22px;
  border: 2px solid var(--nb-brown-mid);
  border-radius: 3px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 13px;
  transition: background 0.2s, border-color 0.2s;
  background: transparent;
}
.nb-check.checked {
  background: var(--nb-olive);
  border-color: var(--nb-olive);
  color: white;
  animation: inkCheck 0.3s ease;
}
.nb-check.priority-mark {
  border-color: var(--nb-rust);
  color: var(--nb-rust);
}

@keyframes inkCheck {
  0%   { transform: scale(0.5) rotate(-15deg); }
  70%  { transform: scale(1.25) rotate(5deg); }
  100% { transform: scale(1) rotate(0deg); }
}

/* category label on todo items */
.todo-cat-tag {
  font-family: 'Lato', sans-serif;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  background: rgba(184, 205, 224, 0.35);
  color: var(--nb-blue);
  border: 1px solid rgba(74, 111, 165, 0.3);
  border-radius: 2px;
  padding: 1px 7px;
  white-space: nowrap;
}

.todo-actions {
  display: flex;
  gap: 4px;
  flex-shrink: 0;
}
.todo-actions .btn {
  padding: 2px 8px;
  font-size: 0.78rem;
  border-radius: 2px;
  font-family: 'Lato', sans-serif;
}

/* inline status badges */
.priority-badge {
  font-family: 'Lato', sans-serif;
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  background: var(--nb-rust);
  color: white;
  border-radius: 2px;
  padding: 1px 6px;
  flex-shrink: 0;
}
.done-badge {
  font-family: 'Lato', sans-serif;
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  background: var(--nb-olive);
  color: white;
  border-radius: 2px;
  padding: 1px 6px;
  flex-shrink: 0;
}

/* category cards */
.category-card {
  background: var(--nb-page);
  border: 2px solid rgba(184, 205, 224, 0.55);
  border-radius: 2px;
  box-shadow: 3px 3px 0 #e0d4b0, 5px 5px 10px var(--nb-shadow);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  position: relative;
  overflow: hidden;
  animation: fadeSlideIn 0.35s ease both;
}
.category-card:hover {
  transform: translateY(-5px) rotate(-0.4deg);
  box-shadow: 5px 8px 0 #d5c9a5, 8px 12px 20px var(--nb-shadow);
}
/* orange tab stripe at top of each card */
.category-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 5px;
  background: var(--nb-orange);
}
.category-card .card-title {
  font-family: 'Playfair Display', serif;
  color: var(--nb-brown);
  font-size: 1.1rem;
}
.category-card .card-title a {
  color: var(--nb-brown);
  text-decoration: none;
}
.category-card .card-title a:hover { color: var(--nb-orange); }

.cat-count-badge {
  font-family: 'Lato', sans-serif;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.5px;
  background: rgba(196, 99, 42, 0.12);
  color: var(--nb-orange);
  border: 1px solid rgba(196, 99, 42, 0.3);
  border-radius: 2px;
  padding: 2px 8px;
}

/* form pages - lined paper style */
.nb-form-page {
  background: var(--nb-page);
  border-left: 5px solid var(--nb-margin);
  border-radius: 2px;
  box-shadow:
    2px 2px 0 #e0d4b0,
    4px 4px 0 #d5c9a5,
    6px 6px 14px var(--nb-shadow);
  padding: 2rem 2.25rem 2rem 2.5rem;
  position: relative;
  margin-top: 28px;
  animation: fadeSlideIn 0.35s ease both;
  background-image: repeating-linear-gradient(
    transparent 0px,
    transparent 39px,
    var(--nb-line) 39px,
    var(--nb-line) 40px
  );
  background-size: 100% 40px;
}
.nb-form-page::before {
  content: '';
  position: absolute;
  top: -22px;
  left: 20px;
  right: 20px;
  height: 22px;
  background-image: radial-gradient(circle at 50% 11px, var(--nb-ring) 7px, transparent 8px);
  background-size: 36px 22px;
  background-repeat: repeat-x;
  background-position: 18px 0;
}

.form-label {
  font-family: 'Playfair Display', serif;
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--nb-brown-mid);
  text-transform: uppercase;
  letter-spacing: 0.8px;
  margin-bottom: 0.3rem;
}

/* underline-only inputs look like fill-in lines on paper */
.form-control,
.form-select {
  background: transparent !important;
  border: none !important;
  border-bottom: 2px solid var(--nb-brown-mid) !important;
  border-radius: 0 !important;
  padding: 0.45rem 0.25rem !important;
  font-family: 'Kalam', cursive;
  font-size: 1.05rem;
  color: var(--nb-brown);
  box-shadow: none !important;
  transition: border-color 0.2s;
}
.form-control:focus,
.form-select:focus {
  border-bottom-color: var(--nb-orange) !important;
  outline: none !important;
}
.form-control::placeholder { color: var(--nb-ring); font-style: italic; }

textarea.form-control { resize: none; }

.form-check-input:checked {
  background-color: var(--nb-orange);
  border-color: var(--nb-orange);
}
.form-check-input:focus {
  border-color: var(--nb-orange);
  box-shadow: 0 0 0 0.2rem rgba(196, 99, 42, 0.25);
}
.form-check-label {
  font-family: 'Kalam', cursive;
  font-size: 1rem;
  color: var(--nb-brown);
}

/* buttons */
.btn {
  font-family: 'Lato', sans-serif;
  border-radius: 2px;
  letter-spacing: 0.4px;
  transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.15s;
}
.btn:active { transform: translateY(1px) !important; }

.btn-primary {
  background: var(--nb-orange) !important;
  border-color: var(--nb-orange) !important;
  color: white !important;
  font-weight: 700;
}
.btn-primary:hover {
  background: var(--nb-brown) !important;
  border-color: var(--nb-brown) !important;
  transform: translateY(-1px);
  box-shadow: 2px 3px 8px var(--nb-shadow);
}

.btn-secondary {
  background: transparent !important;
  border: 2px solid var(--nb-brown-mid) !important;
  color: var(--nb-brown) !important;
  font-weight: 700;
}
.btn-secondary:hover {
  background: var(--nb-brown) !important;
  color: var(--nb-cream) !important;
}

.btn-warning {
  background: var(--nb-yellow) !important;
  border-color: var(--nb-yellow) !important;
  color: var(--nb-brown) !important;
  font-weight: 700;
}
.btn-warning:hover { background: #d4ac34 !important; border-color: #d4ac34 !important; }

.btn-danger {
  background: var(--nb-rust) !important;
  border-color: var(--nb-rust) !important;
  color: white !important;
  font-weight: 700;
}
.btn-danger:hover { background: #a03030 !important; border-color: #a03030 !important; }

.btn-success {
  background: var(--nb-olive) !important;
  border-color: var(--nb-olive) !important;
  color: white !important;
  font-weight: 700;
}

.btn-outline-primary {
  border-color: var(--nb-orange) !important;
  color: var(--nb-orange) !important;
  border-width: 2px !important;
}
.btn-outline-primary:hover {
  background: var(--nb-orange) !important;
  color: white !important;
  transform: translateY(-1px);
}

.btn-outline-secondary {
  border-color: var(--nb-brown-mid) !important;
  color: var(--nb-brown-mid) !important;
  border-width: 2px !important;
}
.btn-outline-secondary:hover {
  background: var(--nb-brown-mid) !important;
  color: white !important;
}

.btn-outline-warning {
  border-color: #c8a832 !important;
  color: #8a7020 !important;
  border-width: 2px !important;
}
.btn-outline-warning:hover {
  background: var(--nb-yellow) !important;
  color: var(--nb-brown) !important;
}

.btn-outline-danger {
  border-color: var(--nb-rust) !important;
  color: var(--nb-rust) !important;
  border-width: 2px !important;
}
.btn-outline-danger:hover {
  background: var(--nb-rust) !important;
  color: white !important;
}

.btn-outline-success {
  border-color: var(--nb-olive) !important;
  color: var(--nb-olive) !important;
  border-width: 2px !important;
}
.btn-outline-success:hover {
  background: var(--nb-olive) !important;
  color: white !important;
}

/* badges */
.badge {
  font-family: 'Lato', sans-serif;
  font-weight: 700;
  font-size: 0.7rem;
  border-radius: 2px;
  letter-spacing: 0.5px;
}
.badge.bg-danger  { background: var(--nb-rust) !important; }
.badge.bg-success { background: var(--nb-olive) !important; }
.badge.bg-primary { background: var(--nb-orange) !important; }
.badge.bg-secondary { background: var(--nb-ring) !important; }
.badge.bg-light   { background: rgba(184,205,224,0.3) !important; color: var(--nb-blue) !important; border: 1px solid rgba(74,111,165,0.25) !important; }

/* flash messages */
.alert {
  font-family: 'Kalam', cursive;
  font-size: 1rem;
  border-radius: 0;
  border-left-width: 5px;
  animation: slideDown 0.3s ease;
}
.alert-success {
  background: rgba(90, 122, 56, 0.1);
  border-color: var(--nb-olive);
  color: #2d4a1a;
}
.alert-danger {
  background: rgba(184, 64, 64, 0.09);
  border-color: var(--nb-rust);
  color: #6b1a1a;
}
.alert-info {
  background: rgba(74, 111, 165, 0.09);
  border-color: var(--nb-blue);
  color: #1d3d6e;
  font-family: 'Kalam', cursive;
}
.alert-warning {
  background: rgba(228, 190, 68, 0.13);
  border-color: var(--nb-yellow);
  color: #5c4800;
}

@keyframes slideDown {
  from { transform: translateY(-12px); opacity: 0; }
  to   { transform: translateY(0); opacity: 1; }
}

/* breadcrumb */
.breadcrumb {
  background: transparent;
  font-family: 'Kalam', cursive;
  font-size: 0.92rem;
  padding: 0;
  margin-bottom: 1rem;
}
.breadcrumb-item a { color: var(--nb-orange); }
.breadcrumb-item.active { color: var(--nb-brown-mid); }
.breadcrumb-item + .breadcrumb-item::before { color: var(--nb-ring); }

/* detail/show page card */
.nb-detail-card {
  background: var(--nb-page);
  border-left: 5px solid var(--nb-orange);
  border-radius: 2px;
  box-shadow: 3px 3px 0 #e0d4b0, 5px 5px 10px var(--nb-shadow);
  padding: 1.75rem 2rem;
  margin-bottom: 1.5rem;
}
.nb-detail-card.completed-card { border-left-color: var(--nb-olive); }
.nb-detail-card.priority-card  { border-left-color: var(--nb-rust); }

.nb-detail-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.65rem;
  color: var(--nb-brown);
  margin-bottom: 1rem;
}
.nb-detail-title.is-crossed {
  text-decoration: line-through;
  opacity: 0.65;
}

.nb-meta-row {
  font-family: 'Kalam', cursive;
  font-size: 0.95rem;
  color: var(--nb-brown-mid);
  border-top: 1px solid var(--nb-line);
  padding-top: 0.5rem;
  margin-top: 0.5rem;
}

/* user profile card */
.user-avatar svg { width: 72px; height: 72px; color: var(--nb-orange); }

.nb-profile-card {
  background: var(--nb-page);
  border-left: 5px solid var(--nb-orange);
  border-radius: 2px;
  box-shadow: 3px 3px 0 #e0d4b0, 6px 6px 14px var(--nb-shadow);
  padding: 2rem;
  margin-top: 28px;
  animation: fadeSlideIn 0.35s ease both;
}

/* override Bootstrap card defaults */
.card {
  background: var(--nb-page);
  border: 2px solid rgba(184, 205, 224, 0.5);
  border-radius: 2px;
  box-shadow: 3px 3px 0 #e0d4b0, 5px 5px 10px var(--nb-shadow);
}
.card-header {
  border-bottom: 2px solid rgba(184, 205, 224, 0.5);
  font-family: 'Playfair Display', serif;
  font-weight: 700;
  background: var(--nb-cream) !important;
  color: var(--nb-brown) !important;
  border-radius: 0 !important;
}
.card-header.bg-primary { background: var(--nb-orange) !important; color: white !important; }
.card-header.bg-warning { background: var(--nb-yellow) !important; color: var(--nb-brown) !important; }
.card-header.bg-dark    { background: var(--nb-brown) !important; color: var(--nb-yellow) !important; }
.card-footer { border-top: 1px solid var(--nb-line); background: transparent !important; }

/* override Bootstrap list-group */
.list-group-item {
  background: transparent;
  border-color: var(--nb-line);
  font-family: 'Kalam', cursive;
}
.list-group-item-action:hover { background: rgba(196, 99, 42, 0.06); }

/* animations */
@keyframes fadeSlideIn {
  from { opacity: 0; transform: translateY(14px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* stagger todo item entrances */
.todo-item { animation: fadeSlideIn 0.3s ease both; }
.todo-item:nth-child(1)  { animation-delay: 0.04s; }
.todo-item:nth-child(2)  { animation-delay: 0.08s; }
.todo-item:nth-child(3)  { animation-delay: 0.12s; }
.todo-item:nth-child(4)  { animation-delay: 0.16s; }
.todo-item:nth-child(5)  { animation-delay: 0.20s; }
.todo-item:nth-child(6)  { animation-delay: 0.24s; }
.todo-item:nth-child(7)  { animation-delay: 0.28s; }
.todo-item:nth-child(8)  { animation-delay: 0.32s; }
.todo-item:nth-child(9)  { animation-delay: 0.36s; }
.todo-item:nth-child(10) { animation-delay: 0.40s; }

.category-card:nth-child(1) .col { animation-delay: 0.05s; }
.category-card:nth-child(2) .col { animation-delay: 0.10s; }
.category-card:nth-child(3) .col { animation-delay: 0.15s; }

/* mobile */
@media (max-width: 768px) {
  .notebook-page::before,
  .nb-form-page::before,
  .hero-section::before { display: none; }
  .hero-brand { font-size: 3rem; }
  .stat-number { font-size: 2.4rem; }
  .todo-cat-tag { display: none; }
}
